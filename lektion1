let cards=[];function loadCards(){const e=localStorage.getItem("german_flashcards_person");if(e)cards=JSON.parse(e);else{cards=[...defaultCards];try{localStorage.setItem("german_flashcards_person",JSON.stringify(cards))}catch(e){}}}function saveCards(){try{localStorage.setItem("german_flashcards_person",JSON.stringify(cards))}catch(e){showToast("Trình duyệt không hỗ trợ lưu!",!1)}}loadCards();let currentIndex=0,isFlipped=!1;const cardInner=document.getElementById("cardInner"),frontContent=document.getElementById("frontContent"),backContent=document.getElementById("backContent"),examplesContainer=document.getElementById("examplesContainer"),examplesList=document.getElementById("examplesList"),prevBtn=document.getElementById("prevBtn"),nextBtn=document.getElementById("nextBtn"),shuffleBtn=document.getElementById("shuffleBtn"),counter=document.getElementById("counter"),listCount=document.getElementById("listCount"),progressBar=document.getElementById("progressBar"),modal=document.getElementById("modal"),cardList=document.getElementById("cardList"),toast=document.getElementById("toast"),toastMsg=document.getElementById("toastMsg"),toastIcon=document.getElementById("toastIcon");function showToast(e,t=!0){toastMsg.innerText=e,toastIcon.className=t?"fas fa-check-circle":"fas fa-exclamation-circle",toastIcon.style.color=t?"#10b981":"#ef4444",toast.classList.add("show"),setTimeout(()=>toast.classList.remove("show"),2e3)}function updateUI(){if(0===cards.length)return frontContent.innerText="Trống",backContent.innerText="Bấm bánh răng để thêm từ mới!",examplesContainer.classList.add("hidden"),counter.innerText="0 / 0",listCount.innerText="0",void(progressBar.style.width="0%");cardInner.classList.remove("is-flipped"),isFlipped=!1,setTimeout(()=>{const e=cards[currentIndex];frontContent.innerText=e.front,backContent.innerText=e.back,examplesList.innerHTML="",e.examples&&e.examples.length>0?(e.examples.forEach(e=>{if(""!==e.trim()){const t=document.createElement("li");t.innerText