<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"><title>SmartFlash Pro - Tự Soạn Từ Vựng</title><link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet"><style>*{box-sizing:border-box;margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}body{background:#f8fafc;color:#334155;min-height:100vh;display:flex;justify-content:center}#app{width:100%;max-width:440px;padding:16px;display:flex;flex-direction:column;min-height:100vh;position:relative}header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}header h1{font-size:24px;font-weight:900;color:#4f46e5;display:flex;align-items:center;gap:8px}#manageBtn{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#64748b;background:#fff;border:1px solid #e2e8f0;cursor:pointer;transition:all .2s;box-shadow:0 1px 2px rgba(0,0,0,.05)}#manageBtn:active{transform:scale(.95)}.progress-container{width:100%;background:#e2e8f0;height:8px;border-radius:9999px;margin-bottom:24px;overflow:hidden}#progressBar{background:#6366f1;height:100%;width:0;transition:width .3s ease}.card-area{flex-grow:1;display:flex;align-items:center;justify-content:center;margin-bottom:24px}#cardContainer{width:100%;height:380px;perspective:1000px;-webkit-perspective:1000px;cursor:pointer}#cardInner{width:100%;height:100%;position:relative;transform-style:preserve-3d;-webkit-transform-style:preserve-3d;transition:transform .5s cubic-bezier(.4,0,.2,1);-webkit-transition:transform .5s cubic-bezier(.4,0,.2,1)}#cardInner.is-flipped{transform:rotateY(180deg);-webkit-transform:rotateY(180deg)}.card-face{position:absolute;inset:0;width:100%;height:100%;border-radius:24px;padding:24px;display:flex;flex-direction:column;align-items:center;justify-content:center;backface-visibili